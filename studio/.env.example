# Copy this file to .env and fill in your own values.

# PostgreSQL connection string (Prisma). Works with any hosted Postgres
# (Supabase, Neon, RDS, etc.) or a local instance.
DATABASE_URL="postgresql://user:password@localhost:5432/ai_marketing_studio"

# Auth.js (NextAuth v5) — generate a real secret for production, e.g.
# `openssl rand -base64 32`.
AUTH_SECRET="replace-with-a-real-secret"
NEXTAUTH_URL="http://localhost:3000"
# Required in production (npm start / any real deployment, including
# Vercel) or every request fails with "UntrustedHost". Not needed for
# `npm run dev`.
AUTH_TRUST_HOST=true

# --- AI providers -----------------------------------------------------
# Set at least one to enable real AI text generation. Without any key,
# the app automatically falls back to a built-in template generator so
# the whole product still works end-to-end — every fallback is clearly
# labeled in the UI and logged in Generation History.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: force a specific text provider. One of: openai, anthropic, gemini.
# Leave blank to auto-detect in that order based on which key is set.
AI_TEXT_PROVIDER=
OPENAI_TEXT_MODEL=gpt-4o-mini
ANTHROPIC_TEXT_MODEL=claude-sonnet-5
GOOGLE_TEXT_MODEL=gemini-1.5-flash

# Image generation — currently implemented for OpenAI (gpt-image-1).
# Without OPENAI_API_KEY, the Image Generator clearly reports that no
# provider is configured instead of faking a result.
AI_IMAGE_PROVIDER=openai
OPENAI_IMAGE_MODEL=gpt-image-1

# Video rendering — no first-party provider is connected yet. The video
# PLAN (hook/scenes/CTA/caption) always generates via the text model
# above; rendering an actual video file requires implementing
# AIVideoProvider in src/lib/ai/providers/video.ts for a provider such
# as Runway, Pika, or Google Veo, then setting AI_VIDEO_PROVIDER here.
AI_VIDEO_PROVIDER=
