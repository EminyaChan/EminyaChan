// AI Marketing Studio — data model
// Postgres in production/dev (DATABASE_URL). Swap the datasource provider to
// "sqlite" for a zero-infra local run if no Postgres instance is available.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth / accounts
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  brands            Brand[]
  contents          Content[]
  templates         Template[]
  campaigns         Campaign[]
  generationHistory GenerationHistory[]
  settings          Settings?
}

// ---------------------------------------------------------------------------
// Brand profile — reused as default context for generation
// ---------------------------------------------------------------------------

model Brand {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  industry          String?
  targetAudience    String?
  voice             String? // brand tone/voice description
  preferredLanguages String[] @default([])
  preferredPlatforms String[] @default([])
  sellingPoints     String[] @default([])
  forbiddenWords    String[] @default([])
  preferredCta      String?
  website           String?
  socialAccounts    Json? // { instagram: "...", xiaohongshu: "...", ... }
  isDefault         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  contents Content[]

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Industries — presets that seed default tone / angles / CTAs
// ---------------------------------------------------------------------------

model Industry {
  id               String   @id @default(cuid())
  key              String   @unique // slug, e.g. "restaurant"
  name             String
  description      String?
  defaultTone      String?
  defaultAudience  String?
  contentAngles    String[] @default([])
  hooks            String[] @default([])
  ctaStyles        String[] @default([])
  objectives       String[] @default([])
  isCustom         Boolean  @default(false)
  createdAt        DateTime @default(now())

  templates Template[]
}

// ---------------------------------------------------------------------------
// Templates — reusable generation presets, industry-linked or custom
// ---------------------------------------------------------------------------

model Template {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  industryId  String?
  industry    Industry? @relation(fields: [industryId], references: [id], onDelete: SetNull)
  name        String
  description String?
  platform    String?
  contentType String?
  tone        String?
  promptHints String? // extra special-instruction text merged into the prompt builder
  isSystem    Boolean  @default(false) // seeded, not user-owned
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([industryId])
}

// ---------------------------------------------------------------------------
// Content — the core generated marketing asset, with version history
// ---------------------------------------------------------------------------

enum ContentStatus {
  DRAFT
  GENERATED
  PUBLISHED
  ARCHIVED
  // Campaign content-calendar lifecycle (Brief -> Strategy -> Calendar ->
  // Content -> Approval -> Schedule -> Publish). Kept alongside the values
  // above rather than replacing them, since quick-generate content (no
  // campaign) still uses DRAFT/GENERATED/PUBLISHED/ARCHIVED directly.
  IDEA
  AI_GENERATED
  EDITING
  PENDING_APPROVAL
  APPROVED
  SCHEDULED
}

enum Platform {
  XIAOHONGSHU
  INSTAGRAM
  FACEBOOK
  TIKTOK
  LINKEDIN
  GOOGLE_ADS
  CUSTOM
}

enum ContentType {
  SOCIAL_POST
  ADVERTISEMENT
  PRODUCT_DESCRIPTION
  VIDEO_SCRIPT
  PROMOTIONAL_COPY
  HEADLINE
  CTA
  EDUCATIONAL_POST
  STORYTELLING
  RECRUITMENT
  REVIEW
  CAMPAIGN_POST
}

enum CampaignStatus {
  PLANNING
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum CampaignObjective {
  BRAND_AWARENESS
  LEAD_GENERATION
  SALES
  ENGAGEMENT
  TRAFFIC
  RECRUITMENT
  PRODUCT_LAUNCH
  EVENT_PROMOTION
}

// A Campaign is the marketing brief and the container for everything that
// flows from it: Strategy -> Content Calendar -> Content (copy/visual/
// video) -> Approval -> Schedule -> Publish. Fields below are the brief
// itself (Step 1 of the workflow); `strategy` and `contents` are what
// later steps attach.
model Campaign {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      CampaignStatus @default(PLANNING)
  platforms   Platform[]     @default([])

  // Marketing brief
  businessName     String?
  industry         String?
  product          String?
  location         String?
  targetAudience   String?
  objective        CampaignObjective?
  budget           String?
  promotion        String?
  startDate        DateTime?
  endDate          DateTime?
  sellingPoints    String[]           @default([])
  competitors      String[]           @default([])
  brandTone        String?
  brandColors      String[]           @default([])
  brandGuidelines  String?
  websiteUrl       String?
  additionalNotes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  strategy MarketingStrategy?
  contents Content[]

  @@index([userId])
}

// AI-generated marketing strategy (Step 2): audience analysis, positioning,
// editable content pillars, and recommended platforms with reasoning. One
// per campaign; regenerating replaces it in place (no version history here
// — unlike Content, a strategy is a single working document, not a
// publishable asset).
model MarketingStrategy {
  id         String   @id @default(cuid())
  campaignId String   @unique
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  // { demographics, interests, painPoints, buyingMotivations, contentPreferences }
  audienceProfile Json?
  // { brandPositioning, usp, keyMessage, differentiation }
  positioning     Json?
  contentPillars  String[] @default([])
  // [{ platform, reason }]
  recommendedPlatforms Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Content {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandId        String?
  brand          Brand?        @relation(fields: [brandId], references: [id], onDelete: SetNull)
  campaignId     String?
  campaign       Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  title          String
  platform       Platform
  industry       String?
  contentType    ContentType
  targetAudience String?
  status         ContentStatus @default(GENERATED)
  isFavorite     Boolean       @default(false)
  tags           String[]      @default([])
  // Content-calendar fields (Step 3) — null for quick-generate content
  // that isn't part of a campaign calendar.
  scheduledDate  DateTime?
  contentPillar  String?

  // Denormalized "current" body for fast list rendering — always mirrors
  // the latest ContentVersion so the library doesn't need a join to render.
  body     String
  cta      String?
  hashtags String[] @default([])
  // Xiaohongshu-specific structured sections, null for other platforms
  sections Json?
  // The original GenerationContext used to create this content, so
  // regeneration (full or per-section) can rebuild an equivalent prompt
  // without asking the user to re-enter business information.
  generationInputs Json?

  currentVersionNumber Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions          ContentVersion[]
  images            GeneratedImage[]
  videos            GeneratedVideo[]
  generationHistory GenerationHistory[]

  @@index([userId])
  @@index([platform])
  @@index([contentType])
  @@index([status])
  @@index([campaignId])
}

model ContentVersion {
  id            String   @id @default(cuid())
  contentId     String
  content       Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  versionNumber Int
  title         String
  body          String
  cta           String?
  hashtags      String[] @default([])
  sections      Json?
  changeNote    String? // e.g. "Regenerated hook", "Full regeneration"
  createdAt     DateTime @default(now())

  @@unique([contentId, versionNumber])
  @@index([contentId])
}

// ---------------------------------------------------------------------------
// Generated media
// ---------------------------------------------------------------------------

enum MediaStatus {
  PENDING
  COMPLETED
  FAILED
}

model GeneratedImage {
  id          String      @id @default(cuid())
  contentId   String?
  content     Content?    @relation(fields: [contentId], references: [id], onDelete: SetNull)
  prompt      String
  style       String?
  aspectRatio String?
  textOverlay String?
  provider    String?
  model       String?
  url         String?
  status      MediaStatus @default(PENDING)
  error       String?
  createdAt   DateTime    @default(now())

  @@index([contentId])
}

model GeneratedVideo {
  id          String      @id @default(cuid())
  contentId   String?
  content     Content?    @relation(fields: [contentId], references: [id], onDelete: SetNull)
  title       String?
  plan        Json // structured hook/scenes/cta plan, always generated
  caption     String?
  hashtags    String[]    @default([])
  thumbnailPrompt String?
  provider    String?
  model       String?
  url         String? // null until a real video-gen API is connected
  status      MediaStatus @default(PENDING)
  error       String?
  createdAt   DateTime    @default(now())

  @@index([contentId])
}

// ---------------------------------------------------------------------------
// Generation history — audit/billing trail for every AI call
// ---------------------------------------------------------------------------

enum GenerationType {
  TEXT
  IMAGE
  VIDEO
}

enum GenerationStatus {
  SUCCESS
  ERROR
  FALLBACK
}

model GenerationHistory {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentId      String?
  content        Content?         @relation(fields: [contentId], references: [id], onDelete: SetNull)
  type           GenerationType
  provider       String
  model          String?
  status         GenerationStatus
  promptTokens   Int?
  completionTokens Int?
  estimatedCostUsd Float?
  errorMessage   String?
  durationMs     Int?
  createdAt      DateTime         @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Per-user settings
// ---------------------------------------------------------------------------

model Settings {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultTextProvider  String?
  defaultImageProvider String?
  defaultVideoProvider String?
  defaultLanguage      String  @default("English")
  updatedAt            DateTime @updatedAt
}
