# Copy this file to .env and fill in your real values. Never commit .env.

# --- Content generation ---
# Set ONE of these. If OPENAI_API_KEY is set, it's used. Otherwise, if
# ANTHROPIC_API_KEY is set, that's used. If neither is set, the agent still
# runs but uses a much more mechanical offline fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# --- Google Sheet (your campaign/content tracker) ---
# The ID is the long string in your sheet's URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Campaigns
# Path to the service account JSON key file (see README for how to create one)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# --- Optional overrides ---
OUTPUT_DIR=output
LOG_FILE=logs/run_log.jsonl

# --- Web app (webapp/) ---
# A shared password everyone on the team uses to open the app. Leave blank
# only for local testing — a blank password means NO login is required.
APP_PASSWORD=
# Random string used to sign session cookies. Any long random value.
SECRET_KEY=
# Defaults to a local SQLite file. Set to a Postgres URL for storage that
# survives redeploys (see README).
DATABASE_URL=
