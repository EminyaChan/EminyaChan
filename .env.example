# Copy this file to .env and fill in your own values.

# Set ONE of these to enable real AI drafting. Without either, the agent
# uses a built-in template generator instead (still works, more generic).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: force which provider to use if you have both keys set.
# One of: openai, anthropic, template. Leave blank to auto-detect
# (OpenAI is preferred if both keys are present).
AI_PROVIDER=

# Optional: override the default model per provider.
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-5

# Port for the review dashboard (default 3000)
PORT=3000
